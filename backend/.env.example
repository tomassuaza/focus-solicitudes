# =====================================================
# Variables de entorno - NO COMMITEAR EL .env REAL
# =====================================================
SPRING_PROFILES_ACTIVE=dev

# Base de datos (prod usa MySQL en Railway)
DB_URL=jdbc:mysql://localhost:3306/focus?useSSL=true&serverTimezone=UTC
DB_USER=focus_user
DB_PASSWORD=cambia-esto

# Google OAuth (Google Cloud Console → OAuth 2.0 Client IDs)
GOOGLE_OAUTH_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_ALLOWED_DOMAIN=focusagency.co

# SMTP Gmail (App Password recomendado, NO usar contraseña personal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notificaciones@focusagency.co
SMTP_PASSWORD=cambia-esto

# JWT propio - mínimo 256 bits (32 chars). Generar con: openssl rand -base64 32
JWT_SECRET=cambia-esto-por-uno-aleatorio-de-al-menos-32-caracteres

# CORS
FRONTEND_URL=http://localhost:5173
